<Window x:Class="kalkulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulator" Height="600" Width="350">
    
    <StackPanel Margin="10">
        <TextBlock x:Name="Layar" FontSize="40" TextAlignment="Right" Margin="0,10,0,20" Text="0"/>
        
        <UniformGrid Columns="3">
            
            <!-- Mengatur ukuran SEMUA tombol secara otomatis dari sini -->
            <UniformGrid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="60"/> <!-- Membesarkan tinggi tombol -->
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="FontSize" Value="20"/> <!-- Membesarkan teks angka -->
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </UniformGrid.Resources>

            <!-- bc = button click -->
            <Button Content="Sci" Click="bc_sci"/>
            <Button Content="def" Click="bc_def"/>
            <Button Content="AC" Click="bc_ac" Background="#FF4C4C" Foreground="White"/>

            <Button Content="1" Click="bc_1"/>
            <Button Content="2" Click="bc_2"/>
            <Button Content="3" Click="bc_3"/>

            <Button Content="4" Click="bc_4"/>
            <Button Content="5" Click="bc_5"/>
            <Button Content="6" Click="bc_6"/>

            <Button Content="7" Click="bc_7"/>
            <Button Content="8" Click="bc_8"/>
            <Button Content="9" Click="bc_9"/>

            <Button Content="0" Click="bc_0"/>
            <Button Content="." Click="bc_dot"/>
            <Button Content="+" Click="bc_plus" Background="Orange" Foreground="White"/>

            <Button Content="-" Click="bc_minus" Background="Orange" Foreground="White"/>
            <Button Content="*" Click="bc_multiply" Background="Orange" Foreground="White"/>
            <Button Content="/" Click="bc_divide" Background="Orange" Foreground="White"/>
            
            <Button Content="=" Click="bc_hitung" Background="LightGreen"/>
            
        </UniformGrid>
    </StackPanel>
</Window>