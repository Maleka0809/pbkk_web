<Window x:Class="AplikasiDesktop.HapusData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hapus Data Mahasiswa" Height="250" Width="400">
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="HAPUS DATA MAHASISWA" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            
            <TextBlock Text="Masukkan NIM yang akan dihapus:"/>
            <TextBox x:Name="InputNimHapus" Margin="0,0,0,15" Height="25"/>
            
            <Button Content="Hapus" Height="35" Click="hapus_data_click" Background="#ff4c4c" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
