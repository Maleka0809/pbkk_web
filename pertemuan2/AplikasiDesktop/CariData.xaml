<Window x:Class="AplikasiDesktop.CariData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cari Data Mahasiswa" Height="250" Width="400">
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="CARI DATA MAHASISWA" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            
            <TextBlock Text="Masukkan NIM yang dicari:"/>
            <TextBox x:Name="InputNimCari" Margin="0,0,0,15" Height="25"/>
            
            <Button Content="Cari" Height="35" Click="cari_data_click"/>
        </StackPanel>
    </Grid>
</Window>
