<Window x:Class="AplikasiDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AplikasiDesktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
      
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <TextBlock Text="Selamat Datang di Aplikasi Desktop" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Content="Masuk" Width="150" Height="50" Click="masuk_click"/>

        </StackPanel>
    </Grid>
</Window>