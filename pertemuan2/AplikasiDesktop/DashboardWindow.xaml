<Window x:Class="AplikasiDesktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem Data Mahasiswa - Dashboard" Height="400" Width="400">
    
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
            <TextBlock Text="MENU UTAMA" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>
            
            <Button Content="Tambah Data" Height="40" Margin="0,5" Click="tambah_data_click"/>
            <Button Content="Cari (Berdasarkan NIM)" Height="40" Margin="0,5" Click="cari_data_click"/>
            <Button Content="Hapus (Berdasarkan NIM)" Height="40" Margin="0,5" Click="hapus_data_click"/>
            <Button Content="Lihat/Refresh Tabel" Height="40" Margin="0,5" Click="lihat_data_click"/>
            
            <Button Content="Keluar" Height="40" Margin="0,20,0,0" Click="keluar_click" Background="#ff4c4c" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>