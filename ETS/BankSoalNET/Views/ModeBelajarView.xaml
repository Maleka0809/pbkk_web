<UserControl x:Class="BankSoalNET.Views.ModeBelajarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI" Foreground="#F8FAFC">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Mode Belajar &amp; Membaca Modul" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Pilih mata kuliah &amp; materi kurikulum di bawah untuk membaca modul lengkap dan melihat bank latihan" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Two Column View: Left List of Cards, Right Detail View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Materi List Sidebar -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,20,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,12">
                        <TextBlock Text="Pilih Mata Kuliah:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbMatkul" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,0,10"
                                  SelectionChanged="CmbMatkul_SelectionChanged"/>
                        <TextBlock Text="Daftar Modul Materi:" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                    <ListBox x:Name="ListMateriCards" SelectionChanged="ListMateriCards_SelectionChanged"
                             Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="#7C3AED" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Pertemuan, StringFormat='P#{0}'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding Tags}" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Judul}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Deskripsi}" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detail Reading Pane -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" Padding="28" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelReading">
                        <!-- Header Details -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border x:Name="BadgePertemuan" Background="#7C3AED" CornerRadius="8" Padding="10,4" Margin="0,0,12,0">
                                <TextBlock x:Name="TxtPertemuan" Text="Pertemuan 1" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="TxtTags" Text="framework, .net, clr" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtJudul" Text="Pengenalan Framework" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtDeskripsi" Text="Konsep dasar framework modern" FontSize="14" Foreground="#94A3B8" Margin="0,0,0,20"/>

                        <!-- Content Text -->
                        <Border Background="#0F172A" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,24">
                            <TextBlock x:Name="TxtKonten" Text="Konten materi..." FontSize="14" Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="22"/>
                        </Border>

                        <!-- Practice Soals Accordion Section -->
                        <TextBlock Text="Latihan Soal Materi Ini" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="ItemsLatihanSoal">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Background="#334155" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Tipe}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Pertanyaan}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
