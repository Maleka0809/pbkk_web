<UserControl x:Class="BankSoalNET.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI" Foreground="#F8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <!-- Header -->
            <TextBlock Text="Dashboard Admin" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Ringkasan data mata kuliah, bank soal kurikulum, dan aktivitas mahasiswa" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,24"/>

            <!-- Metric Cards (5 Cards) -->
            <Grid Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Matkul -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Padding="16" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#7C3AED" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="SchoolOutline" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Mata Kuliah" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtTotalMatkul" Text="3" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Materi -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" Padding="16" Margin="4,0,4,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#3B82F6" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="BookOpenOutline" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Materi" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtTotalMateri" Text="10" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3: PG -->
                <Border Grid.Column="2" Background="#1E293B" CornerRadius="16" Padding="16" Margin="4,0,4,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#10B981" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="CheckboxMarkedCircleOutline" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pilihan Ganda" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtTotalPG" Text="24" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 4: Essay -->
                <Border Grid.Column="3" Background="#1E293B" CornerRadius="16" Padding="16" Margin="4,0,4,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#F59E0B" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="Pen" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Soal Essay" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtTotalEssay" Text="8" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 5: Hasil -->
                <Border Grid.Column="4" Background="#1E293B" CornerRadius="16" Padding="16" Margin="8,0,0,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#8B5CF6" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="AccountSchoolOutline" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ujian Selesai" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtTotalHasil" Text="0" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Two Tables Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Table 1: Materi List -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Padding="20" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Modul Perkuliahan Terdaftar" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <DataGrid x:Name="GridMateriOverview" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                  RowBackground="#1E293B" AlternatingRowBackground="#172234"
                                  Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                                  CanUserAddRows="False" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="P#" Binding="{Binding Pertemuan}" Width="50"/>
                                <DataGridTextColumn Header="Mata Kuliah" Binding="{Binding MataKuliah.Singkatan}" Width="100"/>
                                <DataGridTextColumn Header="Judul Materi" Binding="{Binding Judul}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Table 2: Recent Activity -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" Padding="20" Margin="12,0,0,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Hasil Ujian Terbaru Mahasiswa" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <DataGrid x:Name="GridRecentHasil" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                  RowBackground="#1E293B" AlternatingRowBackground="#172234"
                                  Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                                  CanUserAddRows="False" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mahasiswa" Binding="{Binding User.NamaLengkap}" Width="*"/>
                                <DataGridTextColumn Header="Materi" Binding="{Binding Materi.Judul}" Width="*"/>
                                <DataGridTextColumn Header="Nilai" Binding="{Binding NilaiTotal}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
