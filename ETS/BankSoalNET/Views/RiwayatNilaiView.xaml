<UserControl x:Class="BankSoalNET.Views.RiwayatNilaiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI" Foreground="#F8FAFC">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Riwayat &amp; Statistik Nilai Saya" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Daftar rekap evaluasi dan skor yang telah Anda kerjakan selama pembelajaran .NET" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1E293B" CornerRadius="16" Padding="24" BorderBrush="#334155" BorderThickness="1">
            <DataGrid x:Name="GridRiwayat" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                      RowBackground="#1E293B" AlternatingRowBackground="#172234"
                      Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                      CanUserAddRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tanggal Ujian" Binding="{Binding SubmittedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="150"/>
                    <DataGridTextColumn Header="Materi / Topik" Binding="{Binding Materi.Judul}" Width="*"/>
                    <DataGridTextColumn Header="PG Benar" Binding="{Binding PgBenar}" Width="90"/>
                    <DataGridTextColumn Header="Total PG" Binding="{Binding PgTotal}" Width="90"/>
                    <DataGridTextColumn Header="Skor Essay" Binding="{Binding EssaySkor}" Width="100"/>
                    <DataGridTemplateColumn Header="Nilai Akhir" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="#0F172A" Padding="8,4" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Nilai}" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
