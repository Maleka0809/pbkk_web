<UserControl x:Class="BankSoalNET.Views.KelolaMateriView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI" Foreground="#F8FAFC">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Kelola Materi Pembelajaran" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Tambah, edit, dan susun materi modul kurikulum sesuai kelompok mata kuliah" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,10"/>

                <!-- Matkul Filter -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mata Kuliah:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbFilterMatkul" Width="260" Height="36" Background="#1E293B" Foreground="White" BorderBrush="#334155"
                              SelectionChanged="CmbFilterMatkul_SelectionChanged"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Click="BtnTambah_Click" Background="#7C3AED" BorderBrush="#7C3AED" Height="40" Padding="16,0" Cursor="Hand" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Tambah Materi Baru" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Content: Left Table, Right Edit/Add Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="440" x:Name="ColEditor"/>
            </Grid.ColumnDefinitions>

            <!-- Table of Materi -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,16,0">
                <DataGrid x:Name="GridMateri" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                          RowBackground="#1E293B" AlternatingRowBackground="#172234"
                          Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                          CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="P#" Binding="{Binding Pertemuan}" Width="50"/>
                        <DataGridTextColumn Header="Mata Kuliah" Binding="{Binding MataKuliah.Singkatan}" Width="100"/>
                        <DataGridTextColumn Header="Judul Materi" Binding="{Binding Judul}" Width="*"/>
                        <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="130"/>
                        <DataGridTemplateColumn Header="Aksi" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Click="BtnRowEdit_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#38BDF8" Height="28" Padding="6,0"/>
                                        <Button Content="Hapus" Click="BtnRowDelete_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#F87171" Height="28" Padding="6,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Editor Form Panel -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" Padding="24" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtFormTitle" Text="Form Tambah Materi" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                        <!-- Mata Kuliah Selection -->
                        <TextBlock Text="Pilih Mata Kuliah" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbFormMatkul" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#475569" Margin="0,0,0,12"/>

                        <TextBlock Text="Pertemuan Ke (Angka)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPertemuan" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="8,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Judul Materi" FontSize="12" Foreground="#94A3B8" Margin="0,10,0,4"/>
                        <TextBox x:Name="TxtJudul" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="8,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Deskripsi Singkat" FontSize="12" Foreground="#94A3B8" Margin="0,10,0,4"/>
                        <TextBox x:Name="TxtDeskripsi" Height="55" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="8,4"/>

                        <TextBlock Text="Tags (Pisahkan koma)" FontSize="12" Foreground="#94A3B8" Margin="0,10,0,4"/>
                        <TextBox x:Name="TxtTags" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="8,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Konten Materi Lengkap" FontSize="12" Foreground="#94A3B8" Margin="0,10,0,4"/>
                        <TextBox x:Name="TxtKonten" Height="140" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="8,4"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Batal" Click="BtnBatal_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#94A3B8" Margin="0,0,8,0"/>
                            <Button x:Name="BtnSimpan" Content="Simpan Materi" Click="BtnSimpan_Click" Background="#7C3AED" BorderBrush="#7C3AED"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
