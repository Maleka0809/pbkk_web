<UserControl x:Class="BankSoalNET.Views.DokumenPdfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#0F172A"
             Foreground="#F8FAFC"
             FontFamily="Segoe UI">

    <Grid>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="FilePdfBox" Width="28" Height="28" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Dokumen Bank Soal &amp; Modul (PDF Full)" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Kumpulan dokumen soal ujian, modul pembelajaran, dan kisi-kisi resmi. Mahasiswa dapat langsung membaca dokumen lengkap di sini." 
                               FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Action Controls: Filter & Upload -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mata Kuliah:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <ComboBox x:Name="CbFilterMatkul" Width="200" Height="36" Background="#1E293B" Foreground="White"
                              BorderBrush="#334155" Padding="10,0" VerticalContentAlignment="Center"
                              SelectionChanged="CbFilterMatkul_SelectionChanged" Margin="0,0,12,0"/>

                    <Button x:Name="BtnUploadPdf" Content="📄 + Upload Dokumen PDF" Click="BtnUploadPdf_Click"
                            Height="36" Background="#7C3AED" BorderBrush="#7C3AED" FontWeight="SemiBold"
                            FontSize="12" Cursor="Hand" Visibility="Visible"/>
                </StackPanel>
            </Grid>

            <!-- Main Content Area: Split List & Full Viewer -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Document List Panel -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,16,0" Padding="16">
                    <DockPanel>
                        <!-- List Header -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid>
                                <TextBlock Text="Daftar Dokumen PDF" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTotalDoc" Text="3 Dokumen" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Search Bar -->
                        <Border DockPanel.Dock="Top" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="8,4" Margin="0,0,0,12">
                            <Grid>
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                <TextBox x:Name="TxtCariDoc" Margin="24,0,0,0" Background="Transparent" Foreground="White" BorderThickness="0"
                                         FontSize="12" VerticalContentAlignment="Center" TextChanged="TxtCariDoc_TextChanged"
                                         materialDesign:HintAssist.Hint="Cari judul atau mata kuliah..."/>
                            </Grid>
                        </Border>

                        <!-- Scrollable Document List -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ItemsDokumen">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" CornerRadius="12" Padding="14" Margin="0,0,0,10"
                                                BorderBrush="#334155" BorderThickness="1" Cursor="Hand"
                                                MouseLeftButtonUp="DokumenCard_Click" Tag="{Binding}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                            <Setter Property="Background" Value="#1E1B4B"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Matkul Chip & Delete (for admin) -->
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <Border Background="#312E81" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding MatkulNama}" FontSize="10" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                                    </Border>
                                                    <Button Content="✕" ToolTip="Hapus Dokumen" Click="BtnDeleteDoc_Click" Tag="{Binding}"
                                                            HorizontalAlignment="Right" Height="22" Width="22" Padding="0"
                                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#F87171"
                                                            Visibility="{Binding DataContext.AdminActionVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </Grid>

                                                <!-- Title -->
                                                <TextBlock Grid.Row="1" Text="{Binding Judul}" FontWeight="Bold" FontSize="13" Foreground="White"
                                                           TextWrapping="Wrap" Margin="0,0,0,4"/>

                                                <!-- Meta: File name & Date -->
                                                <StackPanel Grid.Row="2">
                                                    <TextBlock Text="{Binding Deskripsi}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileOutline" Width="14" Height="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding UkuranFile}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <materialDesign:PackIcon Kind="CalendarClock" Width="14" Height="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding TanggalUploadFormatted}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Right: Full PDF Reader / Viewer -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Document Active Header Bar -->
                        <Border Grid.Row="0" Background="#0F172A" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border x:Name="BadgeActiveMatkul" Background="#065F46" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock x:Name="TxtActiveMatkul" Text="PBKK (.NET)" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                        <TextBlock x:Name="TxtActiveTitle" Text="Pilih dokumen PDF untuk mulai membaca" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtActiveDesc" Text="Viewer PDF interaktif dengan navigasi zoom, cetak, pencarian kata, dan halaman." FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>

                                <!-- Viewer Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnOpenExternal" Content="🚀 Buka di Layar Penuh (Edge/Adobe)" Click="BtnOpenExternal_Click"
                                            Height="34" Background="#334155" Foreground="White" BorderThickness="0"
                                            Padding="12,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                            ToolTip="Buka di pembaca PDF sistem / browser default" Margin="0,0,8,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Embedded WebView2 PDF Viewer -->
                        <Border Grid.Row="1" Background="#020617" CornerRadius="12" ClipToBounds="True" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <wv2:WebView2 x:Name="PdfWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <!-- Empty / Fallback State -->
                                <Border x:Name="PanelEmptyState" Background="#0F172A" Visibility="Visible">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="72" Height="72" CornerRadius="20" Background="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Width="44" Height="44" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Pilih Dokumen Bank Soal PDF" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Klik salah satu dokumen dari daftar di sebelah kiri untuk langsung membaca soal &amp; pembahasan secara penuh di sini." 
                                                   FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
