<UserControl x:Class="BankSoalNET.Views.KelolaMatkulView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI" Foreground="#F8FAFC">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Kelola Mata Kuliah" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Kelola daftar mata kuliah, SKS, semester, dan tema warna kelompok materi" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Click="BtnTambah_Click" Background="#7C3AED" BorderBrush="#7C3AED" Height="40" Padding="16,0" Cursor="Hand" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Tambah Mata Kuliah" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Layout: Grid List on Left, Form on Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420" x:Name="ColEditor"/>
            </Grid.ColumnDefinitions>

            <!-- Table Card -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,16,0">
                <DataGrid x:Name="GridMatkul" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                          RowBackground="#1E293B" AlternatingRowBackground="#172234"
                          Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                          CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="80" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Nama Mata Kuliah" Binding="{Binding Nama}" Width="*"/>
                        <DataGridTextColumn Header="Singkatan" Binding="{Binding Singkatan}" Width="110"/>
                        <DataGridTextColumn Header="SKS" Binding="{Binding Sks}" Width="60"/>
                        <DataGridTextColumn Header="Sem" Binding="{Binding Semester}" Width="60"/>
                        <DataGridTemplateColumn Header="Aksi" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Click="BtnRowEdit_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#38BDF8" Height="28" Padding="6,0"/>
                                        <Button Content="Hapus" Click="BtnRowDelete_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#F87171" Height="28" Padding="6,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Form Card -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" Padding="24" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtFormTitle" Text="Form Tambah Mata Kuliah" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                        <TextBlock Text="Kode Mata Kuliah" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtKode" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,2" Margin="0,0,0,12"/>

                        <TextBlock Text="Nama Lengkap Mata Kuliah" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNama" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,2" Margin="0,0,0,12"/>

                        <TextBlock Text="Singkatan / Nama Pendek" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtSingkatan" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,2" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SKS" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtSks" Text="3" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,2"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Semester" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtSemester" Text="4" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,2"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ikon Emoji" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtIcon" Text="⚡" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,2"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tema Warna" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbWarna" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#475569">
                                    <ComboBoxItem Content="Purple (Ungu Neon)" Tag="purple" IsSelected="True"/>
                                    <ComboBoxItem Content="Cyan (Cyber Blue)" Tag="cyan"/>
                                    <ComboBoxItem Content="Orange (Warm Gold)" Tag="orange"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Deskripsi Mata Kuliah" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtDeskripsi" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="8,4"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Batal" Click="BtnBatal_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#94A3B8" Margin="0,0,8,0"/>
                            <Button x:Name="BtnSimpan" Content="Simpan Matkul" Click="BtnSimpan_Click" Background="#7C3AED" BorderBrush="#7C3AED"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
