<Window x:Class="BankSoalNET.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Bank Soal .NET - Masuk &amp; Pendaftaran" Height="700" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="32,24">
            <StackPanel VerticalAlignment="Center">
                <!-- Header Icon & Title -->
                <Border Width="64" Height="64" CornerRadius="18" Background="#7C3AED" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <materialDesign:PackIcon Kind="SchoolOutline" Width="36" Height="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Bank Soal .NET" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#F8FAFC"/>
                <TextBlock Text="Platform Pembelajaran &amp; Evaluasi PBKK" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                <!-- Mode Switcher: Masuk vs Daftar -->
                <Border Background="#1E293B" CornerRadius="12" Padding="4" Margin="0,0,0,18" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="TabLogin" Content="🔑 Masuk" IsChecked="True" Checked="TabMode_Changed"
                                     GroupName="ModeGroup" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                     Foreground="#F8FAFC" Height="40" FontSize="13" FontWeight="SemiBold"/>
                        <RadioButton x:Name="TabRegister" Grid.Column="1" Content="✨ Daftar Akun" Checked="TabMode_Changed"
                                     GroupName="ModeGroup" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                     Foreground="#F8FAFC" Height="40" FontSize="13" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <!-- ================= PANEL LOGIN ================= -->
                <StackPanel x:Name="PanelLogin" Visibility="Visible">

                    <!-- Form Card -->
                    <Border Background="#1E293B" CornerRadius="16" Padding="24" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Username" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtUsername" Text="admin" Height="40" Padding="10,4"
                                     Background="#0F172A" Foreground="White" BorderBrush="#475569"
                                     FontSize="14" VerticalContentAlignment="Center"/>

                            <TextBlock Text="Password" FontSize="12" Foreground="#94A3B8" Margin="0,16,0,6"/>
                            <PasswordBox x:Name="TxtPassword" Password="admin123" Height="40" Padding="10,4"
                                         Background="#0F172A" Foreground="White" BorderBrush="#475569"
                                         FontSize="14" VerticalContentAlignment="Center"/>

                            <TextBlock x:Name="TxtError" Text="" Foreground="#F87171" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <Button x:Name="BtnLogin" Content="Masuk ke Sistem" Click="BtnLogin_Click"
                                    Margin="0,20,0,0" Height="44" Background="#7C3AED" BorderBrush="#7C3AED"
                                    FontSize="14" FontWeight="SemiBold" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick fill presets -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <TextBlock Text="Quick fill: " Foreground="#64748B" VerticalAlignment="Center" FontSize="12"/>
                        <Button Content="Admin Demo" Click="FillAdmin_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#A78BFA" FontSize="12" Height="28" Padding="6,0"/>
                        <TextBlock Text="|" Foreground="#475569" VerticalAlignment="Center" Margin="4,0"/>
                        <Button Content="Mhs Demo" Click="FillMhs_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#38BDF8" FontSize="12" Height="28" Padding="6,0"/>
                    </StackPanel>

                    <!-- Switch to Register Link -->
                    <Button Content="Belum punya akun? Daftar sekarang →" Click="SwitchToRegister_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#818CF8"
                            HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12"/>
                </StackPanel>

                <!-- ================= PANEL REGISTER ================= -->
                <StackPanel x:Name="PanelRegister" Visibility="Collapsed">
                    <!-- Role Selector for Register -->
                    <TextBlock Text="Pilih Peran Akun Baru:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <Border Background="#1E293B" CornerRadius="12" Padding="4" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbRegMhs" Content="🎓 Mahasiswa" IsChecked="True"
                                         GroupName="RegRoleGroup" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                         Foreground="#F8FAFC" Height="36"/>
                            <RadioButton x:Name="RbRegAdmin" Grid.Column="1" Content="👨‍💼 Admin / Dosen"
                                         GroupName="RegRoleGroup" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                         Foreground="#F8FAFC" Height="36"/>
                        </Grid>
                    </Border>

                    <!-- Form Card Register -->
                    <Border Background="#1E293B" CornerRadius="16" Padding="24" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Nama Lengkap" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtRegNama" Height="40" Padding="10,4"
                                     Background="#0F172A" Foreground="White" BorderBrush="#475569"
                                     FontSize="14" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Contoh: Muhammad Budi"/>

                            <TextBlock Text="Username (untuk login)" FontSize="12" Foreground="#94A3B8" Margin="0,14,0,6"/>
                            <TextBox x:Name="TxtRegUsername" Height="40" Padding="10,4"
                                     Background="#0F172A" Foreground="White" BorderBrush="#475569"
                                     FontSize="14" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Contoh: budi123"/>

                            <TextBlock Text="Password" FontSize="12" Foreground="#94A3B8" Margin="0,14,0,6"/>
                            <PasswordBox x:Name="TxtRegPassword" Height="40" Padding="10,4"
                                         Background="#0F172A" Foreground="White" BorderBrush="#475569"
                                         FontSize="14" VerticalContentAlignment="Center"/>

                            <TextBlock Text="Konfirmasi Password" FontSize="12" Foreground="#94A3B8" Margin="0,14,0,6"/>
                            <PasswordBox x:Name="TxtRegConfirmPassword" Height="40" Padding="10,4"
                                         Background="#0F172A" Foreground="White" BorderBrush="#475569"
                                         FontSize="14" VerticalContentAlignment="Center"/>

                            <TextBlock x:Name="TxtRegStatus" Text="" Foreground="#F87171" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <Button x:Name="BtnRegister" Content="✨ Buat Akun Baru" Click="BtnRegister_Click"
                                    Margin="0,20,0,0" Height="44" Background="#10B981" BorderBrush="#10B981"
                                    FontSize="14" FontWeight="SemiBold" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Switch to Login Link -->
                    <Button Content="← Sudah punya akun? Masuk di sini" Click="SwitchToLogin_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#818CF8"
                            HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
