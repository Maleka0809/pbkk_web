<UserControl x:Class="BankSoalNET.Views.ModeScoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI" Foreground="#F8FAFC">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Selector -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="16" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Mode Scoring &amp; Evaluasi Ujian" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Kerjakan seluruh soal dalam modul sekaligus. Skor dihitung secara otomatis!" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,12"/>
                    
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <TextBlock Text="Mata Kuliah:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbMatkulScoring" Width="220" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#475569"
                                      SelectionChanged="CmbMatkulScoring_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <TextBlock Text="Pilih Modul Materi:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbMateriScoring" Width="280" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#475569"
                                      SelectionChanged="CmbMateriScoring_SelectionChanged"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnSubmitUjian" Content="Kirim Jawaban &amp; Hitung Nilai" Click="BtnSubmitUjian_Click"
                        Background="#10B981" BorderBrush="#10B981" Height="44" Padding="20,0" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content Area: Quiz Questions or Result -->
        <Grid Grid.Row="1">
            <!-- Questions List Scrollable -->
            <ScrollViewer x:Name="ScrollQuiz" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelQuestionsContainer" Margin="0,0,12,0">
                    <!-- Dynamic question cards will be generated here -->
                </StackPanel>
            </ScrollViewer>

            <!-- Result Overlay / Card -->
            <Border x:Name="PanelResult" Visibility="Collapsed" Background="#0F172A" CornerRadius="16" Padding="32" BorderBrush="#7C3AED" BorderThickness="2" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="700">
                <StackPanel>
                    <materialDesign:PackIcon Kind="TrophyOutline" Width="54" Height="54" Foreground="#FBBF24" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Hasil Evaluasi Ujian" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBlock x:Name="TxtResultSubtitle" Text="Modul: ..." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                    <!-- Big Score Display -->
                    <Border Background="#1E293B" CornerRadius="16" Padding="24" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Center" Width="260" Margin="0,0,0,20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="NILAI AKHIR" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtFinalScore" Text="85" FontSize="56" FontWeight="Black" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            <Border x:Name="BadgeStatus" CornerRadius="12" Background="#064E3B" Padding="12,4" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock x:Name="TxtStatus" Text="LULUS DENGAN SANGAT BAIK" FontWeight="Bold" FontSize="11" Foreground="#6EE7B7"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Breakdown Details -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Pilihan Ganda" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtPgScore" Text="2 / 2 Benar (100%)" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Kesesuaian Essay" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtEssayScore" Text="75% Kata Kunci Cocok" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Content="Ulangi Ujian Ini" Click="BtnUlangi_Click" Background="#7C3AED" BorderBrush="#7C3AED" Height="40" HorizontalAlignment="Center" Padding="24,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
