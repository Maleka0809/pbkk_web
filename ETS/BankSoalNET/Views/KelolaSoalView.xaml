<UserControl x:Class="BankSoalNET.Views.KelolaSoalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI" Foreground="#F8FAFC">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Filters -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Kelola Bank Soal" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Tambah soal pilihan ganda, essay, diagram gambar (PNG), dan lampiran dokumen PDF" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,12"/>

                <!-- Filters -->
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <TextBlock Text="Mata Kuliah:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbFilterMatkul" Width="220" Height="36"
                                  Background="#1E293B" Foreground="White" BorderBrush="#334155"
                                  SelectionChanged="CmbFilterMatkul_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <TextBlock Text="Topik / Materi:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbFilterMateri" Width="280" Height="36"
                                  Background="#1E293B" Foreground="White" BorderBrush="#334155"
                                  SelectionChanged="CmbFilterMateri_SelectionChanged"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>

            <Button Grid.Column="1" Click="BtnTambah_Click" Background="#7C3AED" BorderBrush="#7C3AED" Height="40" Padding="16,0" Cursor="Hand" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Tambah Soal Baru" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Grid: Left Questions List, Right Form -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="480" x:Name="ColEditor"/>
            </Grid.ColumnDefinitions>

            <!-- List of Questions -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,16,0">
                <DataGrid x:Name="GridSoal" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                          RowBackground="#1E293B" AlternatingRowBackground="#172234"
                          Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                          CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipe" Binding="{Binding Tipe}" Width="90"/>
                        <DataGridTextColumn Header="Pertanyaan" Binding="{Binding Pertanyaan}" Width="*"/>
                        <DataGridTemplateColumn Header="Media" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼️" Visibility="{Binding HasGambar, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,4,0" ToolTip="Ada Diagram PNG"/>
                                        <TextBlock Text="📄" Visibility="{Binding HasPdf, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Ada Dokumen PDF"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Aksi" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Click="BtnRowEdit_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#38BDF8" Height="28" Padding="6,0"/>
                                        <Button Content="Hapus" Click="BtnRowDelete_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#F87171" Height="28" Padding="6,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Editor Form Panel -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" Padding="24" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtFormTitle" Text="Form Tambah Soal" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                        <!-- Mata Kuliah Selection -->
                        <TextBlock Text="Mata Kuliah" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbFormMatkul" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#475569" Margin="0,0,0,10"
                                  SelectionChanged="CmbFormMatkul_SelectionChanged"/>

                        <!-- Target Materi -->
                        <TextBlock Text="Materi / Topik Terkait" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbFormMateri" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#475569" Margin="0,0,0,12"/>

                        <!-- Tipe Soal Toggle -->
                        <TextBlock Text="Tipe Soal" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="RbPG" Content="Pilihan Ganda" IsChecked="True" Checked="TipeSoal_Changed" GroupName="TipeGroup" Margin="0,0,16,0" Foreground="White"/>
                            <RadioButton x:Name="RbEssay" Content="Essay (Kata Kunci)" Checked="TipeSoal_Changed" GroupName="TipeGroup" Foreground="White"/>
                        </StackPanel>

                        <!-- Pertanyaan -->
                        <TextBlock Text="Isi Pertanyaan" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPertanyaan" Height="65" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="8,4" Margin="0,0,0,14"/>

                        <!-- Section: Lampiran Gambar & PDF -->
                        <Border Background="#0F172A" CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Lampiran Gambar (PNG/JPG) &amp; Dokumen PDF" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8"/>

                                <!-- Gambar Attachment Row -->
                                <TextBlock Text="Gambar / Diagram Soal:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🖼️ Pilih Gambar" Click="BtnPilihGambar_Click" Height="30" Padding="8,0" Background="#334155" Foreground="White" BorderThickness="0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtGambarPath" Text="Belum ada gambar" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Content="✕" Click="BtnHapusGambar_Click" ToolTip="Hapus gambar" Height="28" Width="28" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#F87171" Padding="0"/>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <!-- Section: Pilihan Ganda -->
                        <StackPanel x:Name="PanelPG" Margin="0,0,0,12">
                            <TextBlock Text="Pilihan A" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPilihanA" Height="32" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,2"/>

                            <TextBlock Text="Pilihan B" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,4"/>
                            <TextBox x:Name="TxtPilihanB" Height="32" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,2"/>

                            <TextBlock Text="Pilihan C" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,4"/>
                            <TextBox x:Name="TxtPilihanC" Height="32" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,2"/>

                            <TextBlock Text="Pilihan D" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,4"/>
                            <TextBox x:Name="TxtPilihanD" Height="32" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,2"/>

                            <TextBlock Text="Kunci Jawaban Benar" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <ComboBox x:Name="CmbJawabanBenar" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#38BDF8">
                                <ComboBoxItem Content="Pilihan A" IsSelected="True"/>
                                <ComboBoxItem Content="Pilihan B"/>
                                <ComboBoxItem Content="Pilihan C"/>
                                <ComboBoxItem Content="Pilihan D"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Section: Essay (Kata Kunci) -->
                        <StackPanel x:Name="PanelEssay" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Kata Kunci Penilaian (Pisahkan koma)" FontSize="12" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Contoh: runtime, CLR, garbage collection, memory" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtKataKunci" Height="55" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F172A" Foreground="White" BorderBrush="#F59E0B" Padding="8,4"/>
                        </StackPanel>

                        <!-- Pembahasan / Penjelasan Kunci -->
                        <TextBlock Text="Pembahasan &amp; Kunci Jawaban Resmi (Opsional)" FontSize="12" Foreground="#A78BFA" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPembahasan" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F172A" Foreground="White" BorderBrush="#7C3AED" Padding="8,4" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Batal" Click="BtnBatal_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#94A3B8" Margin="0,0,8,0"/>
                            <Button x:Name="BtnSimpan" Content="Simpan Soal" Click="BtnSimpan_Click" Background="#7C3AED" BorderBrush="#7C3AED"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
